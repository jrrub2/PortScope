# Publish only application source, required build tools, licenses and demo screenshots.
# Everything else stays local unless this allowlist is deliberately changed.
/*
!/.gitignore
!/LICENSE
!/README.md
!/package.json
!/pnpm-lock.yaml
!/server.js
!/lib/
/lib/*
!/lib/*.js
!/lib/icmp-worker.ps1
!/frontend/
/frontend/*
!/frontend/src/
/frontend/src/**
!/frontend/src/**/
!/frontend/src/**/*.ts
!/frontend/src/**/*.tsx
!/frontend/src/**/*.js
!/frontend/src/**/*.css
!/frontend/src/lib/world-land.json
!/frontend/index.html
!/frontend/tsconfig.json
!/frontend/vite.config.mts
!/frontend/THIRD-PARTY-NOTICES.txt
!/web/
/web/*
!/web/assets/
/web/assets/*
!/web/assets/*.js
!/web/assets/*.css
!/web/index.html
!/web/favicon.svg
!/web/THIRD-PARTY-NOTICES.txt
!/screenshots/
/screenshots/*
!/screenshots/overview.png
!/screenshots/traceroute.png
!/screenshots/atlas.png
!/tools/
/tools/*
!/tools/check-frontend.mjs
!/tools/update-notices.mjs
!/tools/package-windows.ps1
!/tools/windows/
/tools/windows/*
!/tools/windows/PortScope.cs
!/tools/windows/compile.ps1

# Never publish credentials, local configuration, profiles, exports or source maps.
node_modules/
.env
.env.*
*.key
*.pem
*.p12
*.pfx
*.log
*.map
*.exe
*.zip
*.tgz
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
